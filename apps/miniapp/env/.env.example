# 小程序环境变量样例（完整模板）
#
# Vite 的 envDir 指向 apps/miniapp/env，因此生效文件是本目录下的 .env / .env.development /
# .env.production / .env.test / .env.local。放在项目根目录的 .env.local 不会被任何模式加载。
# 本目录所有真实 env 文件已被 .gitignore 忽略，请复制本样例后按需修改：
#
#   cp apps/miniapp/env/.env.example apps/miniapp/env/.env
#
# 变量名必须以 VITE_ 为前缀才会暴露给业务代码（loadEnv 会把整个文件按字符串读入，
# 比较布尔语义时需写成字符串 'true' / 'false'）。
# 缺失项会在构建期直接失败，例如 VITE_APP_PROXY_ENABLE 缺失会让
# vite.config.ts 的 JSON.parse(VITE_APP_PROXY_ENABLE) 抛错。

# ---- 应用标识与标题 ----
VITE_APP_TITLE = '企业内训'
VITE_UNI_APPID = '__UNI__YOUR_APP_ID'
VITE_WX_APPID = ''

# ---- 开发服务器 ----
VITE_APP_PORT = 9000
VITE_APP_PUBLIC_BASE = '/'
VITE_APP_ROUTER_MODE = 'hash'

# ---- 构建期开关 ----
VITE_DELETE_CONSOLE = 'false'
VITE_SHOW_SOURCEMAP = 'false'
VITE_COPY_NATIVE_RES_ENABLE = 'false'

# ---- 后端地址 ----
# 后端接口本身带 /api/v1 前缀，VITE_SERVER_HAS_API_PREFIX 决定请求层是否再拼一次前缀
VITE_SERVER_BASEURL = 'http://127.0.0.1:8081'
VITE_SERVER_HAS_API_PREFIX = 'false'
# 微信开发者工具「开发版」环境专用地址；不配则回落到 VITE_SERVER_BASEURL
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://127.0.0.1:8081'

# ---- H5 本地代理（仅 dev server 生效）----
VITE_APP_PROXY_ENABLE = 'false'
VITE_APP_PROXY_PREFIX = '/api'

# ---- 登录态 ----
# 'single' 单账号模式；多账号可按需扩展
VITE_AUTH_MODE = 'single'
# 本地 Mock 微信登录：'true' 时登录页显示手机号模拟入口，仅用于无小程序资质时的联调。
# 建议写在 env/.env.development（只在 development 生效），避免带入生产构建。
VITE_APP_MOCK_WECHAT = 'false'

# ---- 微信开发者工具 CLI（供 pnpm dev:mp 自动拉起 IDE，按本机实际情况填写）----
WECHAT_DEVTOOLS_CLI_PATH = ''
